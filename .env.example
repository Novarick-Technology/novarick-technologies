# Supabase pooled connection string (Supavisor, transaction mode) — use
# this over the direct connection for serverless/edge deploys on Vercel.
# Get it from Project Settings > Database in the Supabase dashboard.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=
ADMIN_PROTECTION=off
ADMIN_USER=
ADMIN_PASSWORD=
# Signs the admin session cookie (see lib/adminSession.ts) — required
# whenever ADMIN_PROTECTION=session. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
